# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: ID of a user allowed to change settings even without Administrator
ADMIN_USER_ID=

# Presence (optional)
# BOT_STATUS=online          # online | idle | dnd | invisible
# ACTIVITY_TYPE=custom       # playing | streaming | listening | watching | competing | custom
# ACTIVITY_NAME=             # activity text; empty = no activity
# ACTIVITY_URL=              # required when ACTIVITY_TYPE=streaming (Twitch/YouTube URL)

# Optional — uncomment to override the defaults defined in src/config.ts
# NODE_ENV=development
# DATABASE_PATH=data/bot.sqlite
# LOG_LEVEL=info             # trace | debug | info | warn | error | fatal
# LOG_PRETTY=true            # default: true in development, false (JSON) in production
# RECONNECT_DELAY_MS=5000
# CONNECT_TIMEOUT_MS=20000
# WATCHDOG_INTERVAL_MS=60000
